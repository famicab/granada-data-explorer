# Frontend (Vite) — opcional.
# URL base de la API. Por defecto el frontend usa "/api" (proxy de Vite en dev).
# VITE_API_URL=http://localhost:8000/api

# Backend (FastAPI) — opcional.
# Orígenes permitidos por CORS, separados por comas. Por defecto "*" (dev local).
# En despliegue, restríngelo a la URL del frontend:
# CORS_ORIGINS=https://tu-frontend.ejemplo.com

# Los scripts no requieren claves ni secretos: solo procesan datos públicos.
